STRING REVERSE:
#include<stdio.h>
#include<string.h>
int main()
{
    char str[]="HELLO";
    int i,j,temp;
    for(i=0,j=4;i<=j;i++,j--)
    {
        temp=str[i];
        str[i]=str[j];
        str[j]=temp;
    }
    printf("%s",str);
    
    return 0;
}



