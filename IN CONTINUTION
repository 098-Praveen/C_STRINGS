COUNTING DIGITS AND ALPHABETS:
#include<stdio.h>
int main()
{
    char str[]="hello123world546";
    int i,digits=0,ch=0;
    for(i=0;str[i]!='\0';i++)
    {
        if(str[i]>=97&&str[i]<=122) or a && z
        {
            ch++;
        }
        
        if(str[i]>=48&&str[i]<=57) or 0 to 9
        {
            digits++;
        }
    }
    printf("%d ",ch);
    printf("%d ",digits);
    return 0;
}
