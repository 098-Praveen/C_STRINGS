STRING REVERSE:
#include<stdio.h>
#include<string.h>
int main()
{
    char str[]="HELLO";
    int i,j,temp;
    for(i=0,j=4;i<=j;i++,j--)
    {
        temp=str[i];
        str[i]=str[j];
        str[j]=temp;
    }
    printf("%s",str);
    
    return 0;
}

DYNAMIC STRING LENGTH:
#include<stdio.h>
#include<string.h>
int main()
{
    char org[]="HELLO";
   
    int i,n,j,temp;
    n=strlen(org);
    printf("%d\n",n);
     char cpy[6];
    for(i=0;i<n;i++)
    {
        cpy[i]=org[i];
    }
    cpy[i]='\0';
    printf("%s\n",cpy);
    for(i=0,j=n-1;i<=j;i++,j--)
    {
        temp=cpy[i];
        cpy[i]=cpy[j];
        cpy[j]=temp;
    }
    printf("%s",cpy);
    int ret=strcmp(org,cpy);
    if(ret==0)
    {
        printf("palindrome");
    }
    else
    {
        printf("not palindorme");
    }
    return 0;
}

CHARACTER FREQUENCY:

character frequency means counting how many times a particualr character appears in a string.
#include<stdio.h>
#include<string.h>
int main()
{
    char str[]="BANANA";
    int i,n,count=0;
    n=sizeof(str)/sizeof(str[0]);
    for(i=0;str[i];i++)
    {
        if(str[i]=='A')
        {
            count++;
        }
    }
    printf("%d",count);
    return 0;
}

