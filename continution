PROGRAMME:
find char with idx:

#include<stdio.h>
#include<string.h>
int main()
{
    char str[]="PROGRAMMING";
    char ch='M';
    int i,idx=0,flag=0;
    for(i=0;str[i]!='\0';i++)
    {
        if(ch==str[i])
        {
            idx=i;
            flag=1;
            break;
        }
        
    }
    if(flag==1)
    {
        printf("character found at idx=%d\n",idx);
    }
    else
    {
        printf("character not found");
  }
    
}

