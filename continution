USING STRING COMPARE:

strcmp is library function used to compare two strings character by character.
strcmp is case sensitive "hello" and "HELLO" is different strings.
if strcmp return value is 0 then strings are equal if not not equal.
  
  #include<stdio.h>
#include<string.h>
int main()
{
    char str1[]="HELLO";
    char str2[]="HELLO";
    
    int result=strcmp(str1,str2);
    
    if(result==0)
    {
        printf("strings are equal");
    }
    else
    {
        printf("strings are not equal");
    }
    return 0;
}
