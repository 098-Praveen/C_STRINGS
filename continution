CHARACTER FREQUENCY ONLY ONCE:
#include<stdio.h>
#include<string.h>
int main()
{
    char str[]="SWISS";
    int i,n,j;
    n=strlen(str);
    
    for(i=0;str[i]!='\0';i++)
    {
        int count=1;
        for(j=i+1;j<n;j++)
        {
            if(str[i]==str[j])
            {
                count++;   
            }
        }
        int seen=0;
        for(j=0;j<i;j++)
        {
            if(str[i]==str[j])
            {
                seen=1;
            }
        }
        if(seen==0&&count==1)
        {
            printf("%c\n",str[i]);
            break;
            
        }
        
    }
    return 0;
}

